{
  "name": "quick-copy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Copy the current tab's URL, or a Markdown link, with one keystroke.",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "watch": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check-render.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "typescript": "^7.0.2"
  }
}
